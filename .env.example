# Copy this file to .env and fill in your SMTP provider's details.
PORT=3000

# Example for Gmail with 2-Step Verification + an App Password:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Where portfolio contact messages should be delivered
CONTACT_TO=saichanduvlk@gmail.com
